# Server
NODE_ENV=production
PORT=5000
CLIENT_URL=https://forestapp-backend.onrender.com

# Database
MONGO_URI=

# Auth
JWT_ACCESS_SECRET=            # min 32 chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Email (Brevo HTTPS API; SMTP is not used)
BREVO_API_KEY=
EMAIL_FROM=                   # verified sender address in Brevo
EMAIL_FROM_NAME=Forest App
EMAIL_VERIFICATION_EXPIRY=24h
PASSWORD_RESET_EXPIRY=10m

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Entitlement token signing (ES256)
ENTITLEMENT_PRIVATE_KEY=      # base64-encoded PEM
ENTITLEMENT_PUBLIC_KEY=       # PEM with newlines written as \n
